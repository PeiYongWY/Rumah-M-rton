---
/* The bare address sends visitors to their language (Netlify redirects do this on the server;
   this page is the fallback). */
import settings from '../content/settings.json';
import { path, abs } from '../lib/i18n';
const to = path(settings.defaultLanguage);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Rumah Márton</title>
<meta name="robots" content="noindex"><link rel="canonical" href={abs(to)}>
<meta http-equiv="refresh" content={`0; url=${to}`}></head>
<body style="background:#F4EFE7;font-family:Georgia,serif"><p><a href={to}>Rumah Márton</a></p></body></html>
